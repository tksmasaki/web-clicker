{
  "name": "web-clicker",
  "version": "1.0.1",
  "description": "Chrome extension that clicks page elements from the keyboard using hint labels.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run generate-icons && wxt build",
    "zip": "npm run generate-icons && wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}

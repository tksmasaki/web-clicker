{
  "name": "web-clicker",
  "version": "1.0.0",
  "description": "Chrome extension that clicks page elements from the keyboard using hint labels.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "build": "npm run generate-icons && wxt build",
    "zip": "npm run generate-icons && wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "generate-icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wxt": "^0.20.26"
  }
}
